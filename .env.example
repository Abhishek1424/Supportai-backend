# Copy to .env and adjust. Never commit .env.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://supportai:supportai@localhost:5432/supportai
# Optional: without it, rate limiting is per-process memory (dev only).
REDIS_URL=redis://localhost:6379/0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars
CORS_ORIGINS=["http://localhost:3000"]
